                  "        const searchableText = [",
                  "            user.firstName,",
                  "            user.lastName,",
                  "            user.maidenName,",
                  "            user.username,",
                  "            user.email",
                  "        ]",
                  "        .filter(Boolean)",
                  "        .join(\" \")",
                  "        .toLowerCase();",
                  "",
                  "        pm.expect(searchableText).to.include(searchTerm);",
