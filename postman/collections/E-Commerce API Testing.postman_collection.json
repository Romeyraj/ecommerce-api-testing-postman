      "name": "Authentication",
      "item": [
        {
          "name": "Login - Valid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 1500 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});",
                  "",
                  "pm.test(\"Response content type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\"))",
                  "        .to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Access token is present\", function () {",
                  "    pm.expect(response).to.have.property(\"accessToken\");",
                  "    pm.expect(response.accessToken).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Refresh token is present\", function () {",
                  "    pm.expect(response).to.have.property(\"refreshToken\");",
                  "    pm.expect(response.refreshToken).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"User ID is present\", function () {",
                  "    pm.expect(response).to.have.property(\"id\");",
                  "    pm.expect(response.id).to.be.a(\"number\");",
                  "});",
                  "",
                  "pm.test(\"Username is correct\", function () {",
                  "    pm.expect(response.username).to.eql(\"emilys\");",
                  "});",
                  "",
                  "pm.environment.set(\"accessToken\", response.accessToken);",
                  "pm.environment.set(\"refreshToken\", response.refreshToken);",
                  "pm.environment.set(\"userId\", response.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
