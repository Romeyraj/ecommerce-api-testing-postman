                  "    pm.expect(response.users.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Search results contain the expected user\", function () {",
                  "    const found = response.users.some(function (user) {",
                  "        return user.username === \"emilys\";",
                  "    });",
                  "",
                  "    pm.expect(found).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"Every returned user matches the search term\", function () {",
                  "    const searchTerm = \"emily\";",
